# ====================================================
# APEX ELITE SUPPORT HUB — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control!
# ====================================================

# Server
PORT=3000
NODE_ENV=development

# Session security — use a long random string in production
SESSION_SECRET=change_me_to_a_long_random_string

# Admin panel
ADMIN_PASSWORD=your_admin_password_here
ADMIN_SECRET_KEY=change_me_to_random_key

# Database (optional — defaults to data/database.sqlite)
# DATABASE_PATH=/var/data/database.sqlite

# File uploads (optional — defaults to public/assets/uploads)
# UPLOAD_DIR=/var/data/uploads

# Set to "true" to skip IP check for admin access
DISABLE_ADMIN_IP_CHECK=true

# Vercel — set automatically by Vercel, do not set manually
# VERCEL=1

# Cloudflare Turnstile Human Verification
TURNSTILE_SITE_KEY=0x4AAAAAAEqMzg-9Js5PCYJ-
TURNSTILE_SECRET=your_turnstile_secret_key_here

